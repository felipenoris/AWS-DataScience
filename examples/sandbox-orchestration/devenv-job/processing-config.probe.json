{
  "ProcessingJobName": "demo-devenv-{{ ts_nodash }}",
  "RoleArn": "arn:aws:iam::<SANDBOX_ACCOUNT_ID>:role/<PROJECT_ROLE_NAME>",
  "AppSpecification": {
    "ImageUri": "<REGISTRY_ACCOUNT_ID>.dkr.ecr.<REGION>.amazonaws.com/awsds-prod-ecr-dev-env@<IMAGE_DIGEST>",
    "ContainerEntrypoint": [
      "/bin/bash",
      "-c",
      "id; ls -ln /opt/ml/processing; touch /opt/ml/processing/outbox/probe && echo WRITE-OK"
    ]
  },
  "ProcessingResources": {
    "ClusterConfig": {
      "InstanceCount": 1,
      "InstanceType": "ml.t3.medium",
      "VolumeSizeInGB": 10,
      "VolumeKmsKeyId": "arn:aws:kms:<REGION>:<SANDBOX_ACCOUNT_ID>:key/<PROJECT_KEY_ID>"
    }
  },
  "NetworkConfig": {
    "EnableNetworkIsolation": true,
    "EnableInterContainerTrafficEncryption": true,
    "VpcConfig": {
      "Subnets": [
        "<SUBNET_AZ1>",
        "<SUBNET_AZ2>"
      ],
      "SecurityGroupIds": [
        "<PROJECT_SG>"
      ]
    }
  },
  "ProcessingInputs": [
    {
      "InputName": "code",
      "S3Input": {
        "S3Uri": "s3://<PROJECTS_BUCKET>/<DOMAIN_ID>/<PROJECT_ID>/shared/awsds-demo-job/",
        "LocalPath": "/opt/ml/processing/code",
        "S3DataType": "S3Prefix",
        "S3InputMode": "File",
        "S3DataDistributionType": "FullyReplicated"
      }
    },
    {
      "InputName": "inbox",
      "S3Input": {
        "S3Uri": "s3://<PROJECTS_BUCKET>/<DOMAIN_ID>/<PROJECT_ID>/shared/orchestration-demo/devenv/inbox/",
        "LocalPath": "/opt/ml/processing/inbox",
        "S3DataType": "S3Prefix",
        "S3InputMode": "File",
        "S3DataDistributionType": "FullyReplicated"
      }
    }
  ],
  "ProcessingOutputConfig": {
    "Outputs": [
      {
        "OutputName": "outbox",
        "S3Output": {
          "S3Uri": "s3://<PROJECTS_BUCKET>/<DOMAIN_ID>/<PROJECT_ID>/shared/orchestration-demo/devenv/outbox/{{ ts_nodash }}/",
          "LocalPath": "/opt/ml/processing/outbox",
          "S3UploadMode": "EndOfJob"
        }
      }
    ],
    "KmsKeyId": "arn:aws:kms:<REGION>:<SANDBOX_ACCOUNT_ID>:key/<PROJECT_KEY_ID>"
  },
  "StoppingCondition": {
    "MaxRuntimeInSeconds": 1800
  },
  "Tags": [
    {
      "Key": "AmazonDataZoneProject",
      "Value": "<PROJECT_ID>"
    }
  ]
}
