# /etc/squid/squid.conf - generated by Terraform at first boot. Do not edit on the host: the State
# Manager association of step 4.10 rewrites the included file every ${reconfigure_schedule} and
# ./aws/proxy.py diffs what is running against what is committed.
#
# The whole file is written here rather than a drop-in in conf.d/. The order of `http_access` rules
# is this file's entire security property, and where a distribution's stock squid.conf places its
# `include /etc/squid/conf.d/*.conf` relative to its own `http_access allow localhost` is a fact
# about a package version that nobody here can verify from a laptop (Lesson 30). Owning the file
# makes the order readable and diffable.
#
# The order, every line of it load-bearing (step 4.8):
#
#   1. deny to_private            before every allow. Without it this host is an L7 bridge between
#                                 VPCs that peering keeps apart - a spoke could reach another spoke
#                                 by asking the proxy - which is the one hole D38's topology cannot
#                                 see. `dst` and not `dstdomain`, so a public name that resolves to
#                                 a private address is caught too.
#   2. the port guards            no plaintext CONNECT, no ports nobody named.
#   3. the per-plane allow-lists  one source range, one domain list, one allow - included from the
#                                 rendered file so a list change is not a config rewrite.
#   4. deny all                   last, so an unlisted name is a fast, named 403 rather than a
#                                 timeout, the symptom nobody diagnoses correctly.

# ------------------------------------------------------------------------------ 1. the bridge
# The estate's private space, generated from one constant (backend.py RFC1918_CIDRS) plus this
# proxy's own two. 169.254.0.0/16 is link-local, and 169.254.169.254 within it is the instance
# metadata service, so this line also stops a client asking the proxy to fetch this host's role
# credentials; 100.64.0.0/10 is CGNAT. Neither is RFC1918, which is why they are here and not in
# the shared constant.
acl to_private dst ${join(" ", rfc1918_cidrs)} 169.254.0.0/16 100.64.0.0/10
http_access deny to_private

# ------------------------------------------------------------------------- 2. the port guards
acl SSL_ports port 443
acl Safe_ports port 80
acl Safe_ports port 443
acl CONNECT method CONNECT
http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports

# --------------------------------------------------------------------- 3. the per-plane lists
# Rendered from the [P] SSM parameter by /usr/local/sbin/awsds-render-squid, at first boot and then
# on every State Manager run. An empty file is the correct, safe state: the estate has allowed
# nothing yet, and part 4 below turns that into a named refusal.
include /etc/squid/conf.d/awsds-planes.conf

# ---------------------------------------------------------------------------- 4. the backstop
http_access deny all

# ------------------------------------------------------------------------------- the listener
# 3128 and not 80/443: an explicit proxy is a distinct listener (D38). Nothing here is a
# transparent intercept, and a client that has not been told to use a proxy has no internet rather
# than a silently rewritten one.
http_port 3128

# ------------------------------------------------------------------------------------ the log
# The fields are step 4.11's, named rather than inherited: time, source, method, the CONNECT host,
# the status, and bytes each way. Squid's stock `squid` format carries elapsed time and hierarchy
# codes and omits the byte count in one direction, so it is replaced rather than extended. %>a is
# the client address, which is why the WireGuard host stops masquerading proxy-bound traffic (step
# 4.7): without that, every line of this log would read "the VPN host" and identify nothing.
#
# The logformat line below carries a doubled percent, and it is not a typo. Squid's strftime escape
# opens with percent-brace, which is also templatefile's directive marker, so the literal has to be
# doubled - and this comment describes it in words rather than showing it, because a comment is
# text like any other line and would collide the same way. Both halves were caught by rendering
# this file, not by reading it (Lesson 54: a program that has never been run is a claim).
logformat awsds %%{%Y-%m-%dT%H:%M:%S%z}tl %>a %rm %ru %>Hs %<st %>st %Ss
access_log /var/log/squid/access.log awsds

# No cache. This proxy controls and records egress rather than accelerating it, and a cache would
# be a copy of fetched content sitting on a [D] disk - a data-perimeter question nobody asked for.
cache deny all

# Squid announces itself to nobody and reveals nothing about the host.
httpd_suppress_version_string on
via off
forwarded_for delete

# The DNS this host uses is the VPC resolver, from the subnet's own DHCP option set, not named
# here. An explicit proxy resolves names on behalf of its clients, which is why the client never
# needs to and why the per-VPC DNS firewall can no longer see a client's lookup (step 4.9's
# premise, and the reason both filters moved here).
