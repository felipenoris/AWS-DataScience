# What this slice reads and does not own: five remote states and one AMI parameter. Every read is
# same-account, so none carries a profile - a profile literal in a .tf file is forbidden (Lesson 14).
#
# egress/ is read, unlike in tooling/: this slice is [E] and `make gitlab-up` applies it after
# egress/, so the generated bypass list is available at apply time, and reading an output of a
# destroyed egress/ fails the plan by name, which is the dependency stated in the only place a plan
# reads it.

data "aws_partition" "current" {}

data "aws_caller_identity" "current" {}

data "terraform_remote_state" "foundation" {
  backend = "s3"

  config = {
    bucket = "awsds-${var.env}-tfstate"
    key    = "${var.account_folder}/foundation/terraform.tfstate"
    region = var.region
  }
}

data "terraform_remote_state" "tooling" {
  backend = "s3"

  config = {
    bucket = "awsds-${var.env}-tfstate"
    key    = "${var.account_folder}/tooling/terraform.tfstate"
    region = var.region
  }
}

data "terraform_remote_state" "egress" {
  backend = "s3"

  config = {
    bucket = "awsds-${var.env}-tfstate"
    key    = "${var.account_folder}/egress/terraform.tfstate"
    region = var.region
  }
}

data "terraform_remote_state" "pki" {
  backend = "s3"

  config = {
    bucket = "awsds-${var.env}-tfstate"
    key    = "${var.account_folder}/pki/terraform.tfstate"
    region = var.region
  }
}

data "terraform_remote_state" "registry" {
  backend = "s3"

  config = {
    bucket = "awsds-${var.env}-tfstate"
    key    = "${var.account_folder}/registry/terraform.tfstate"
    region = var.region
  }
}

# x86_64, which is the point of the slice: the sagemaker-distribution base publishes no arm64 tag
# and SMUS spaces run on x86 instance types (the buildbox's argument, 6c 5.8). Read through the
# public parameter, never as an `ami-` literal (architecture.md, "Region portability"), and held by
# each runner's `ignore_changes = [ami]` (Stage 8 decision 25): a host keeps the image it was
# created on, so an Amazon Linux release replaces no running runner, and a host this slice creates
# takes the newest. The runners read `insecure_value`, since an AMI id is public: a plan then
# prints the id where `value` prints `(sensitive value)`.
data "aws_ssm_parameter" "al2023" {
  name = "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
}
