# production/tooling/ - GitLab CE (Stage 7 step 1, D8, D14), layer [D]: stopped between sessions by
# `make gitlab-down`, started by `make gitlab-up`, never destroyed by either.
#
# One t4g.large in VPC-SharedServices' private tier, its data on a separate 50 GiB volume mounted
# at /var/opt/gitlab, its bulky state in S3 and its secrets in Secrets Manager (foundation/'s [P]
# anchors, 1.1), reached by name over the VPN at https://gitlab.awsds.internal and serving Pages at
# https://*.awsds-pages.internal. TLS terminates on the instance's own nginx with the internal CA's
# leaves (decision 1; pki/, step 2); the internet is the explicit proxy, told to every Omnibus
# component (1.3); there is no NAT and no default route anywhere (D38).
#
# ------------------------------------------------------------------------------------------
# What is deliberately outside the user data (1.3, decision 8, Lesson 64)
#
# User data runs at first boot only. With `user_data_replace_on_change` (the proxy host's setting)
# every template edit would replace the host that holds the repositories; without it, an edit
# never reaches the host. So the user data is a small bootstrap that rarely changes, HELD by
# `ignore_changes` below, and the configuration travels outside it:
#
#   gitlab.rb      rendered here from gitlab.rb.tftpl into an S3 object the bootstrap fetches, and
#                  a later change reaches the running host as `sudo awsds-gitlab-refresh` in an
#                  SSM session (fetch again, `gitlab-ctl reconfigure`). The plan shows the rendered
#                  file as the object's content, so it is read before the first apply (Lesson 54).
#                  Comments stay out of the rendered file: the reasoning is in this slice.
#   the leaves     their certificates in pki/'s parameters, their keys in pki/'s secrets, fetched
#                  by the host's role at boot and at every refresh - never in user data, which
#                  anyone holding ec2:DescribeInstanceAttribute reads.
#   gitlab-secrets.json  restored from foundation/'s container, or generated by the first
#                  reconfigure and pushed into it (1.5).
#
# The AMI is held too: an SSM-resolved AMI replaced a [D] host on its next apply at 6g, and a
# replaced GitLab moves its address and loses its first boot's state. The data volume would survive
# (it is a separate resource, re-attached to the new instance) and the records would follow; what
# would not is the two volumes' consistency, so a replacement is a decision taken by tainting.
# ------------------------------------------------------------------------------------------

locals {
  zone        = var.zone_ids[var.zone_index]
  gitlab_host = "gitlab.awsds.internal"
  pages_host  = "awsds-pages.internal"
  proxy_url   = "http://proxy.awsds.internal:3128"

  objects_bucket = data.terraform_remote_state.foundation.outputs.gitlab_objects_bucket
  backup_bucket  = data.terraform_remote_state.foundation.outputs.gitlab_backup_bucket
  gitlab_rb_key  = "config/gitlab.rb"

  saml_enabled = var.saml_idp_sso_target_url != ""

  gitlab_rb = templatefile("${path.module}/gitlab.rb.tftpl", {
    gitlab_host             = local.gitlab_host
    pages_host              = local.pages_host
    proxy_url               = local.proxy_url
    no_proxy                = var.no_proxy
    region                  = var.region
    objects_bucket          = local.objects_bucket
    backup_bucket           = local.backup_bucket
    saml_enabled            = local.saml_enabled
    saml_idp_sso_target_url = var.saml_idp_sso_target_url
    # One line: Ruby reads the escaped newlines back into a PEM.
    saml_idp_cert = replace(trimspace(var.saml_idp_cert_pem), "\n", "\\n")
  })

  user_data = templatefile("${path.module}/user-data.sh.tftpl", {
    proxy_url                 = local.proxy_url
    no_proxy                  = var.no_proxy
    region                    = var.region
    objects_bucket            = local.objects_bucket
    gitlab_rb_key             = local.gitlab_rb_key
    gitlab_host               = local.gitlab_host
    pages_host                = local.pages_host
    ca_root_param             = data.terraform_remote_state.pki.outputs.ca_root_parameter_name
    leaf_gitlab_param         = data.terraform_remote_state.pki.outputs.leaf_parameter_names["gitlab"]
    leaf_pages_param          = data.terraform_remote_state.pki.outputs.leaf_parameter_names["pages"]
    leaf_gitlab_secret_arn    = data.terraform_remote_state.pki.outputs.leaf_key_secret_arns["gitlab"]
    leaf_pages_secret_arn     = data.terraform_remote_state.pki.outputs.leaf_key_secret_arns["pages"]
    gitlab_secrets_secret_arn = data.terraform_remote_state.foundation.outputs.gitlab_secrets_secret_arn
  })
}

# The private subnet's zone name, read from the subnet itself: the data volume is created in a
# zone NAME while everything else here anchors on the zone ID (Stage 3 step 1.5), and the subnet
# is the one object that holds both.
data "aws_subnet" "private" {
  id = data.terraform_remote_state.foundation.outputs.private_subnet_ids[local.zone]
}

# ------------------------------------------------------------------- the security groups (1.2)
#
# GitLab admits HTTPS from three sources and nothing else:
#
#   the WireGuard host's group   a laptop on the tunnel arrives as the host's address (the host
#                                masquerades everything but proxy-bound traffic, 6c pass 8 and
#                                6g), so the group that names the host names every laptop. A
#                                same-account, cross-VPC reference over the peering.
#   the Interactive private tiers  where a SMUS project's app ENI is the source (INT-09): the two
#                                /18s of Sandbox today, generated from the allocation table, one
#                                more pair per vended unit (D35).
#   the runners' group           in this VPC, below. The group is here rather than in runners/ so
#                                this [D] rule never references an [E] object: a group a rule
#                                still names cannot be deleted, and `make gitlab-down` would fail
#                                on the runner's group every session.
#
# No port 22: Session Manager is the shell, and the one SSH surface this design admits anywhere is
# none. No port 80: the records carry https:// and nothing redirects. A rule description refuses
# `'` and `>`, and only at apply (Stage 3).
resource "aws_security_group" "gitlab" {
  # checkov:skip=CKV_AWS_382:egress is unrestricted by design - this tier has no default route, the internet is the explicit proxy, and its 3128-only group plus the absent route are the bound (the buildbox's argument, 6c 5.8)
  name        = "awsds-${var.env}-gitlab"
  description = "GitLab CE - HTTPS from the tunnel host, the Interactive private tiers and the runners; nothing else (Stage 7 step 1.2)"
  vpc_id      = data.terraform_remote_state.foundation.outputs.vpc_id

  ingress {
    description     = "HTTPS from a laptop on the tunnel - the WireGuard host masquerades it (6c pass 8)"
    from_port       = 443
    to_port         = 443
    protocol        = "tcp"
    security_groups = [data.terraform_remote_state.networking.outputs.wireguard_security_group_id]
  }

  ingress {
    description = "HTTPS from a SMUS project app in an Interactive private tier - the INT-09 clone"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = var.interactive_private_cidrs
  }

  ingress {
    description     = "HTTPS from the build runners - jobs clone and the Pages job reads back"
    from_port       = 443
    to_port         = 443
    protocol        = "tcp"
    security_groups = [aws_security_group.runner.id]
  }

  egress {
    description = "no default route in this tier - the internet is the proxy, and its allow-list is the control"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "awsds-${var.env}-gitlab"
  }
}

# The runners' group, attached by production/runners/ (step 6.1). No ingress block: an
# aws_security_group with none admits nothing, Session Manager needs no inbound rule, and a job's
# result leaves as an image push or a GitLab API call, both outbound.
resource "aws_security_group" "runner" {
  # checkov:skip=CKV2_AWS_5:attached by production/runners/, a different slice - the [D]/[E] split this file explains above. The check cannot see across two state files
  # checkov:skip=CKV_AWS_382:the same argument as the group above: the absent route and the proxy are the control
  name        = "awsds-${var.env}-runner"
  description = "GitLab build runners - no ingress at all (Session Manager needs none); the internet is the explicit proxy (Stage 7 step 6.1)"
  vpc_id      = data.terraform_remote_state.foundation.outputs.vpc_id

  egress {
    description = "no default route in this tier - the internet is the proxy, and its allow-list is the control"
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "awsds-${var.env}-runner"
  }
}

# ------------------------------------------------------------------------------- the role (1.3)
#
# Session Manager, S3 on the two buckets, KMS on their key, the three secrets (two reads, one
# read-and-write) and the three published certificates - and nothing else. No ecr:, no
# iam:, nothing in another account: GitLab the application holds no AWS permission a project's
# runner could borrow (6.1 keeps the deploy permissions off the runner role for the same reason).
#
# permissions_boundary is null by decision, not by omission; the iam-role module makes it
# unforgettable by requiring the argument. This is an EC2 service role authored by the identity
# that authors boundaries (Lesson 18). The role NAME is a contract with foundation/'s and pki/'s
# secret policies, which carve `awsds-<env>-gitlab` out of their GetSecretValue deny.
module "role" {
  # checkov:skip=CKV_TF_1:pinned by git TAG by convention (conventions §6, Stage 3 step 1.1a) - a repository-internal tag only the repo owner can move
  source = "git::git@github.com:felipenoris/AWS-DataScience.git//terraform-modules/iam-role?ref=iam-role-v0.1.0"

  name        = "awsds-${var.env}-gitlab"
  description = "GitLab CE host - Session Manager, its two buckets and their key, its three secrets, the published certificates (Stage 7 step 1.3)"

  permissions_boundary = null

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "AllowEc2Service"
        Effect    = "Allow"
        Principal = { Service = "ec2.amazonaws.com" }
        Action    = "sts:AssumeRole"
      }
    ]
  })

  managed_policy_arns = [
    "arn:${data.aws_partition.current.partition}:iam::aws:policy/AmazonSSMManagedInstanceCore",
  ]

  inline_policies = {
    # The two buckets: object storage (consolidated, `use_iam_profile`) and the backup upload. The
    # bucket-level actions are what Fog and Workhorse call while listing a prefix; the object-level
    # ones are a read, a write, a delete and the two halves of a multipart upload.
    "gitlab-buckets" = jsonencode({
      Version = "2012-10-17"
      Statement = [
        {
          Sid    = "ListTheTwoBuckets"
          Effect = "Allow"
          Action = [
            "s3:ListBucket",
            "s3:GetBucketLocation",
            "s3:ListBucketMultipartUploads",
          ]
          Resource = [
            data.terraform_remote_state.foundation.outputs.gitlab_objects_bucket_arn,
            data.terraform_remote_state.foundation.outputs.gitlab_backup_bucket_arn,
          ]
        },
        {
          Sid    = "ReadWriteTheirObjects"
          Effect = "Allow"
          Action = [
            "s3:GetObject",
            "s3:PutObject",
            "s3:DeleteObject",
            "s3:AbortMultipartUpload",
            "s3:ListMultipartUploadParts",
          ]
          Resource = [
            "${data.terraform_remote_state.foundation.outputs.gitlab_objects_bucket_arn}/*",
            "${data.terraform_remote_state.foundation.outputs.gitlab_backup_bucket_arn}/*",
          ]
        },
        # Both buckets encrypt under the GitLab key with bucket keys on; every write generates a
        # data key and every read decrypts one, as this role.
        {
          Sid    = "UseTheGitLabKey"
          Effect = "Allow"
          Action = [
            "kms:Decrypt",
            "kms:Encrypt",
            "kms:GenerateDataKey",
            "kms:GenerateDataKeyWithoutPlaintext",
            "kms:ReEncryptFrom",
            "kms:ReEncryptTo",
            "kms:DescribeKey",
          ]
          Resource = data.terraform_remote_state.foundation.outputs.gitlab_key_arn
        },
      ]
    })

    # The three secrets by ARN (1.5, 2.4). Put on the gitlab-secrets container alone: the first
    # boot pushes the generated file there, and nothing else this host does writes a secret.
    "gitlab-secrets" = jsonencode({
      Version = "2012-10-17"
      Statement = [
        {
          Sid    = "ReadTheLeafKeysAndTheSecretsFile"
          Effect = "Allow"
          Action = "secretsmanager:GetSecretValue"
          Resource = [
            data.terraform_remote_state.pki.outputs.leaf_key_secret_arns["gitlab"],
            data.terraform_remote_state.pki.outputs.leaf_key_secret_arns["pages"],
            data.terraform_remote_state.foundation.outputs.gitlab_secrets_secret_arn,
          ]
        },
        {
          Sid      = "PushTheGeneratedSecretsFileOnce"
          Effect   = "Allow"
          Action   = "secretsmanager:PutSecretValue"
          Resource = data.terraform_remote_state.foundation.outputs.gitlab_secrets_secret_arn
        },
        {
          Sid      = "ReadThePublishedCertificates"
          Effect   = "Allow"
          Action   = "ssm:GetParameter"
          Resource = values(data.terraform_remote_state.pki.outputs.parameter_arns)
        },
      ]
    })
  }
}

resource "aws_iam_instance_profile" "this" {
  name = "awsds-${var.env}-gitlab"
  role = module.role.role_name
}

# -------------------------------------------------------------------------- the rendered config
#
# The object the bootstrap and the refresh helper fetch (decision 8). Its content is the rendered
# template, so a plan shows the whole gitlab.rb as a diff on this resource and nothing else changes
# when the configuration does.
resource "aws_s3_object" "gitlab_rb" {
  bucket                 = local.objects_bucket
  key                    = local.gitlab_rb_key
  content                = local.gitlab_rb
  content_type           = "text/plain"
  server_side_encryption = "aws:kms"
  kms_key_id             = data.terraform_remote_state.foundation.outputs.gitlab_key_arn

  tags = {
    Name = "awsds-${var.env}-gitlab-rb"
  }
}

# -------------------------------------------------------------------------------- the data volume
#
# /var/opt/gitlab - repositories, PostgreSQL, Redis, local Pages deployments. A resource of its own
# rather than a block device of the instance, so a replacement of the instance re-attaches the same
# volume and a stop/start never touches it. Encrypted under the GitLab key (foundation/), snapshotted
# daily by the DLM policy below, which finds it by the tag.
resource "aws_ebs_volume" "data" {
  availability_zone = data.aws_subnet.private.availability_zone
  size              = var.data_volume_size
  type              = "gp3"
  encrypted         = true
  kms_key_id        = data.terraform_remote_state.foundation.outputs.gitlab_key_arn

  tags = {
    Name        = "awsds-${var.env}-gitlab-data"
    "awsds:dlm" = "gitlab-data"
  }
}

# ------------------------------------------------------------------------------------- the host
resource "aws_instance" "gitlab" {
  # checkov:skip=CKV_AWS_126:detailed monitoring is 5x the metric volume for one host whose alarm is on the free basic status checks - CloudWatch spend is Stage 12's subject
  # checkov:skip=CKV_AWS_88:no public address is set here and none is inherited - the subnet is the private tier, which has no default route
  ami           = data.aws_ssm_parameter.al2023_arm64.value
  instance_type = var.instance_type
  ebs_optimized = true

  subnet_id                   = data.terraform_remote_state.foundation.outputs.private_subnet_ids[local.zone]
  vpc_security_group_ids      = [aws_security_group.gitlab.id]
  iam_instance_profile        = aws_iam_instance_profile.this.name
  associate_public_ip_address = false

  user_data = local.user_data

  metadata_options {
    http_endpoint               = "enabled"
    http_tokens                 = "required"
    http_put_response_hop_limit = 1
  }

  root_block_device {
    encrypted   = true
    volume_size = var.root_volume_size
    volume_type = "gp3"
  }

  # The Name tag is a contract: scripts/slices.py stops and starts this host by `awsds-prod-gitlab`
  # (layers.DORMANT_HOST_NAMES), ./aws/supplychain.py SC-1 reads it by the same string.
  tags = {
    Name = "awsds-${var.env}-gitlab"
  }

  lifecycle {
    # Both held (1.2, 1.3): the AMI because an SSM-resolved AMI replaced a [D] host at 6g and this
    # one holds the repositories; the user data because it runs once and its content is a
    # bootstrap, while the configuration it fetches changes through the S3 object above.
    ignore_changes = [ami, user_data]
  }
}

resource "aws_volume_attachment" "data" {
  device_name = "/dev/sdf"
  volume_id   = aws_ebs_volume.data.id
  instance_id = aws_instance.gitlab.id

  # A detach while GitLab runs would corrupt the database it is writing; stopping first is the
  # only safe order, and it is the order a replacement needs anyway.
  stop_instance_before_detaching = true
}

# --------------------------------------------------------------------------------- the two names (1.4)
#
# Both records carry the instance's primary private IPv4, which survives stop/start (measured on
# the proxy host at 6g; verification i reads it again here). Both zones are [P] and were created at
# 6c pass 2; the records are a property of this [D] slice's instance, so they live here (Lesson 4).
resource "aws_route53_record" "gitlab" {
  zone_id = data.terraform_remote_state.foundation.outputs.awsds_internal_zone_id
  name    = local.gitlab_host
  type    = "A"
  ttl     = 60
  records = [aws_instance.gitlab.private_ip]
}

resource "aws_route53_record" "pages" {
  zone_id = data.terraform_remote_state.foundation.outputs.awsds_pages_internal_zone_id
  name    = "*.${local.pages_host}"
  type    = "A"
  ttl     = 60
  records = [aws_instance.gitlab.private_ip]
}

# ----------------------------------------------------------------------------- the snapshots (1.2)
#
# Data Lifecycle Manager: one daily snapshot of the data volume, seven kept. The policy is free;
# snapshot storage is 0.05 USD/GB-month (docs/PRICING.md, measured 2026-10-12), incremental after
# the first. The volume is selected by its tag, never by id, so a replaced volume with the same tag
# keeps the schedule.
module "dlm_role" {
  # checkov:skip=CKV_TF_1:pinned by git TAG by convention (conventions §6, Stage 3 step 1.1a) - a repository-internal tag only the repo owner can move
  source = "git::git@github.com:felipenoris/AWS-DataScience.git//terraform-modules/iam-role?ref=iam-role-v0.1.0"

  name        = "awsds-${var.env}-gitlab-dlm"
  description = "Data Lifecycle Manager - the daily snapshot of GitLab's data volume (Stage 7 step 1.2)"

  permissions_boundary = null

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
      {
        Sid       = "AllowDlmService"
        Effect    = "Allow"
        Principal = { Service = "dlm.amazonaws.com" }
        Action    = "sts:AssumeRole"
        Condition = {
          StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id }
        }
      }
    ]
  })

  managed_policy_arns = [
    "arn:${data.aws_partition.current.partition}:iam::aws:policy/service-role/AWSDataLifecycleManagerServiceRole",
  ]
}

resource "aws_dlm_lifecycle_policy" "data" {
  description        = "awsds-${var.env}-gitlab-data - daily snapshots of GitLab's data volume, ${var.snapshot_retain_count} kept (Stage 7 step 1.2)"
  execution_role_arn = module.dlm_role.role_arn
  state              = "ENABLED"

  policy_details {
    resource_types = ["VOLUME"]
    target_tags = {
      "awsds:dlm" = "gitlab-data"
    }

    schedule {
      name      = "daily"
      copy_tags = true

      create_rule {
        interval      = 24
        interval_unit = "HOURS"
        times         = ["03:30"]
      }

      retain_rule {
        count = var.snapshot_retain_count
      }
    }
  }

  tags = {
    Name = "awsds-${var.env}-gitlab-data"
  }
}

# -------------------------------------------------------------------------------------- the alarm
#
# On the status checks, like the hub hosts'. `missing` is NOT breaching here, unlike the proxy's:
# this host is stopped between sessions by design, and an alarm that is red every night teaches its
# reader to ignore it. The price is that a dead host and a stopped one read alike until a session
# starts it, which `make gitlab-up` does. No action is wired: D12 left the budget notifying nobody.
resource "aws_cloudwatch_metric_alarm" "health" {
  alarm_name          = "awsds-${var.env}-gitlab-status-check"
  alarm_description   = "GitLab is failing its EC2 status checks while running (Stage 7 step 1.2)."
  namespace           = "AWS/EC2"
  metric_name         = "StatusCheckFailed"
  statistic           = "Maximum"
  period              = 60
  evaluation_periods  = 3
  threshold           = 0
  comparison_operator = "GreaterThanThreshold"
  treat_missing_data  = "notBreaching"

  dimensions = {
    InstanceId = aws_instance.gitlab.id
  }
}
